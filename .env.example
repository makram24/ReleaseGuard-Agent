# Required. Used by the root agent and specialist reviewers.
GEMINI_API_KEY=

# Required. Fine-grained PAT with:
# - Contents: Read
# - Pull requests: Read and write
# - Checks: Read
GITHUB_TOKEN=

# Optional. Defaults to makram24/ReleaseGuard-Agent
# RELEASE_GUARD_REPO=makram24/ReleaseGuard-Agent

# Optional. Defaults to gemini-3.1-flash-lite
# RELEASE_GUARD_MODEL=gemini-3.1-flash-lite
